# Local Vite dev-server proxy target.
# BioScale uses 8001 locally to avoid colliding with other apps that use 8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# Production/static builds should set VITE_API_BASE to the deployed backend URL.
# Leave it unset for local development so browser requests go through Vite's /api proxy.
